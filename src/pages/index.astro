---
import '@fontsource/fredoka/latin-500.css';
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-600.css';
import '@fontsource/nunito/latin-700.css';
import '@fontsource/nunito/latin-400-italic.css';
import '../styles/theme.css';
import fixture from '../../public/data/animals/aye-aye.json';
import schedule from '../../public/data/schedule.json';
import { renderAnimal } from '../lib/render';
import type { Animal } from '../../data-pipeline/types';
const catalog = Object.values(import.meta.glob('../../public/data/animals/*.json',{eager:true,import:'default'})) as Animal[];
const themes=Object.fromEntries(catalog.map(a=>[a.id,a.theme]));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Zoologist — A new animal every day</title>
<meta name="description" content="A small daily dose of the extraordinary. Meet a remarkable animal through beautiful photography, surprising facts, and a closer look at its world."/>
<meta name="theme-color" content={fixture.theme.accent}/>
<meta property="og:title" content="Zoologist — A new animal every day"/><meta property="og:description" content="The world is full of extraordinary neighbors. Meet one today."/><meta property="og:type" content="website"/><meta property="og:image" content="/img/aye-aye-1200.webp"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/>
<link rel="manifest" href="/site.webmanifest"/>
<meta name="application-name" content="Zoologist"/>
<meta name="apple-mobile-web-app-title" content="Zoologist"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="mobile-web-app-capable" content="yes"/>
<script is:inline define:vars={{themes,schedule}}>
(function(){
 const now=new Date(),today=[now.getFullYear(),String(now.getMonth()+1).padStart(2,'0'),String(now.getDate()).padStart(2,'0')].join('-');
 let date=new URLSearchParams(location.search).get('date');
 if(!date||!/^\d{4}-\d{2}-\d{2}$/.test(date)||!Number.isFinite(Date.parse(date))||new Date(date+'T00:00:00Z').toISOString().slice(0,10)!==date||date>today)date=today;
 let index=Math.floor((Date.parse(date+'T00:00:00Z')-Date.parse(schedule.launch+'T00:00:00Z'))/86400000);
 if(index<0||index>=schedule.order.length){date=today;index=Math.floor((Date.parse(today+'T00:00:00Z')-Date.parse(schedule.launch+'T00:00:00Z'))/86400000);}
 const id=schedule.order[index]||schedule.fallback,theme=themes[id]||themes[schedule.fallback];
 const dark=matchMedia('(prefers-color-scheme: dark)').matches;
 for(const [key,value] of Object.entries(dark?theme.dark:theme.tokens))document.documentElement.style.setProperty('--accent-'+key,value);
 document.documentElement.style.setProperty('--accent',theme.accent);
 document.documentElement.style.setProperty('--accent-bright',theme.accentDark);
 document.querySelector('meta[name="theme-color"]').content=theme.accent;
 if(id!=='aye-aye')document.documentElement.dataset.pending='true';
})();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to today’s animal</a>
<header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="Zoologist home"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="2.2"><ellipse cx="8" cy="10" rx="3" ry="4" transform="rotate(-25 8 10)"/><ellipse cx="15" cy="6" rx="3" ry="4"/><ellipse cx="23" cy="9" rx="3" ry="4" transform="rotate(25 23 9)"/><path d="M9 21c0-4 3-9 7-9s8 5 8 9c0 6-5 4-8 4s-7 2-7-4Z"/></g></svg><span>Zoologist</span></a><span class="tagline">A new animal every day</span><time id="header-date" datetime="2026-10-28">Wednesday, October 28, 2026</time></div></header>
<main id="main" class="container">
<div id="archive-banner" class="archive-banner" hidden>From the field notes: <span></span><a href="/">Back to today</a></div>
<div id="animal-content" aria-busy="false" set:html={renderAnimal(fixture as Animal)}/>
<footer class="daily-footer"><div><p id="countdown-label">Next animal in</p><strong id="countdown">A little while…</strong></div><button type="button" id="share-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7"/></svg>Share today’s animal</button></footer>
<p id="share-message" role="status" aria-live="polite"></p><p class="signoff">A little curiosity goes a long way. <span aria-hidden="true">✦</span></p>
<noscript><p class="noscript">You’re viewing our aye-aye field note. Enable JavaScript to see the daily selection, countdown, and unit controls.</p></noscript>
</main>
<script>
 import '../lib/client';
</script>
</body></html>
